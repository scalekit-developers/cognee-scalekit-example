# Copy the lines you need into .env once Respan gives you a key at kickoff.
# Never commit .env.

RESPAN_API_KEY=<key-from-respan-at-the-event>

# Route Cognee's LLM + embedding calls through the Respan gateway
LLM_PROVIDER=custom
LLM_ENDPOINT=https://api.respan.ai/api
LLM_API_KEY=<same-respan-key>
LLM_MODEL=openai/gpt-5-mini

EMBEDDING_PROVIDER=custom
EMBEDDING_ENDPOINT=https://api.respan.ai/api
EMBEDDING_API_KEY=<same-respan-key>
EMBEDDING_MODEL=openai/text-embedding-3-large
EMBEDDING_DIMENSIONS=3072
