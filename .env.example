# ---- Memory mode -------------------------------------------------------------
# cloud: every remember/recall goes to Cognee Cloud (needs COGNEE_API_KEY + COGNEE_BASE_URL)
# local: the cognee SDK runs on this machine (needs LLM_API_KEY)
# Leave empty to pick cloud when COGNEE_BASE_URL is set, else local.
MEMORY_MODE=

# Cognee Cloud: https://platform.cognee.ai/sign-up → API Keys
COGNEE_API_KEY=
# Tenant URL from the same page. Include https://
COGNEE_BASE_URL=

# Local mode only: the LLM key cognee uses to build and query the graph.
# OpenAI by default; see https://docs.cognee.ai for other providers.
LLM_API_KEY=
# Optional, local mode: skip the per-answer feedback LLM call for faster recall.
AUTO_FEEDBACK=false

# ---- Code graph --------------------------------------------------------------
# What "Index this repo" indexes. Empty = this checkout in local mode, the public
# GitHub URL in cloud mode (Cloud clones the URL itself).
CODE_REPO_URL=
CODE_DATASET=desk_code

# ---- Scalekit: https://app.scalekit.com → Developers → Settings → API Credentials
SCALEKIT_ENVIRONMENT_URL=
SCALEKIT_CLIENT_ID=
SCALEKIT_CLIENT_SECRET=
SCALEKIT_REDIRECT_URI=http://localhost:5001/callback
# openssl rand -base64 32
COOKIE_ENCRYPTION_SECRET=
# Optional if the access token has no email:
# SCALEKIT_ALICE_SUB=usr_...
# SCALEKIT_BOB_SUB=usr_...
SLACK_CONNECTION_NAME=slack
# Slack channel name without #. Example: general
SLACK_CHANNEL=
